# Backend (container listens on 5000; host mapping is optional in dev)
SERVER_PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=1

# Frontend dev server (Vite)
FRONTEND_PORT=5173

# Production nginx HTTP port on the host
HTTP_PORT=80

# Used by Vite in Docker dev only (service name on compose network)
VITE_PROXY_TARGET=http://backend:5000
